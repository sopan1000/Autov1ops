# Copy to .env and fill in when deploying against real GCP.
# None of these are required for `docker-compose up` (local demo mode).

# --- Tool backend switches ---
MOCK_TOOLS=true            # false = call real Cloud Logging/Monitoring/GitHub/kubectl
STORE_BACKEND=local        # local | firestore
USE_REAL_GEMINI=false      # false = heuristic diagnosis, true = real Gemini call

# --- GCP ---
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-pro
K8S_NAMESPACE=autoops-sandbox

# --- GitHub (for real deploy-history lookups) ---
GITHUB_REPO=your-org/autoops
GITHUB_TOKEN=

# --- Slack (optional; local dashboard works without it) ---
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# --- Local dev only ---
LOCAL_DB_PATH=agent/data/db.json
