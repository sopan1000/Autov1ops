# Copy to .env and fill in when deploying against real GCP.
# None of these are required for `docker-compose up` (local demo mode).

# --- Tool backend switches ---
MOCK_TOOLS=true            # false = call real Cloud Logging/Monitoring/GitHub/kubectl
STORE_BACKEND=local        # local | firestore
USE_REAL_GEMINI=false      # true = Gemini agents via ADK; false = offline heuristic (also the automatic fallback)

# --- GCP ---
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=us-central1
K8S_NAMESPACE=autoops-sandbox
GKE_CLUSTER=autoops-sandbox        # GKE cluster name; falls back to K8S_NAMESPACE's value if unset
GKE_LOCATION=us-central1           # falls back to GCP_LOCATION if unset

# --- Gemini (agent/adk_pipeline.py) ---
GOOGLE_API_KEY=                    # AI Studio key: quickest way to test locally. Leave empty on GCP to use Vertex AI + the service account
GEMINI_MODEL=gemini-2.5-flash      # model for all agents; use the newest one your Vertex AI region offers
GEMINI_DIAGNOSIS_MODEL=            # optional stronger model just for the diagnoser, e.g. gemini-2.5-pro
AUTO_REMEDIATE=false               # true = apply low-risk fixes without approval when Gemini is confident
AUTO_REMEDIATE_MIN_CONFIDENCE=0.9

# --- Production API hardening (agent/main.py) ---
AUTOOPS_API_KEY=                   # if set, all endpoints except /health, /ready, /slack/* require `Authorization: Bearer <this>`
CORS_ORIGINS=http://localhost:3000 # comma-separated list of origins allowed to call the API from a browser
PUBSUB_AUDIENCE=                   # the Cloud Run service URL; required for /events/pubsub to verify the push subscription's OIDC token

# --- GitHub (for real deploy-history lookups) ---
GITHUB_REPO=your-org/autoops
GITHUB_TOKEN=

# --- Slack (optional; local dashboard works without it) ---
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# --- Local dev only ---
LOCAL_DB_PATH=agent/data/db.json
